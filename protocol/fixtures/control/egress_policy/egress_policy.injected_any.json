{
  "version": 5,
  "allow": [
    {
      "host": "git.example.com",
      "ports": [
        80,
        443
      ],
      "layer": "base"
    },
    {
      "host": "files.example.com",
      "ports": [
        443
      ],
      "layer": "workstream"
    },
    {
      "host": "api.example.com",
      "ports": [
        443
      ],
      "layer": "workstream"
    }
  ],
  "passthrough": [],
  "inject": [
    {
      "name": "svc",
      "hosts": [
        "git.example.com",
        "api.example.com",
        "files.example.com"
      ],
      "placeholder": "nest-ph-svc",
      "locations": [
        {
          "type": "authorization_basic_password"
        }
      ]
    },
    {
      "name": "client:push",
      "hosts": [
        "git.example.com"
      ],
      "placeholder": "nest-ph.cli_01JTESTCLIENT.push.",
      "locations": [
        {
          "type": "authorization_basic_password"
        }
      ]
    }
  ],
  "tcp": [],
  "limits": {
    "max_connections": 256,
    "bandwidth_mbps": 200,
    "max_inspected_body_bytes": 536870912
  },
  "guards": [
    {
      "name": "push-floor",
      "hosts": [
        "git.example.com"
      ],
      "scope": [
        {
          "path": "/**/git-receive-pack"
        },
        {
          "path": "/**/info/refs",
          "query": [
            {
              "name": "service",
              "values": [
                "git-receive-pack"
              ]
            }
          ]
        }
      ],
      "allow": [
        {
          "injected": "*",
          "at": "authorization"
        }
      ],
      "reason": "the cell's: a push carries a credential nest injected",
      "ignore_case": true
    },
    {
      "name": "no-credential-uploads",
      "hosts": [
        "files.example.com"
      ],
      "scope": [
        {
          "path": "/upload/**",
          "injected": "*"
        }
      ],
      "reason": "the operator's: no injected credential goes to uploads"
    },
    {
      "name": "client:api-write",
      "hosts": [
        "api.example.com"
      ],
      "scope": [
        {
          "methods_except": [
            "GET",
            "HEAD"
          ]
        }
      ],
      "allow": [
        {
          "methods": [
            "POST"
          ],
          "path": "/query",
          "injected": "*"
        }
      ]
    }
  ]
}
