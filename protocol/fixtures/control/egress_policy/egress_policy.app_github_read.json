{
  "version": 3,
  "allow": [
    {
      "host": "github.com",
      "ports": [
        443
      ],
      "layer": "base"
    },
    {
      "host": "*.githubusercontent.com",
      "ports": [
        443
      ],
      "layer": "base"
    },
    {
      "host": "api.github.com",
      "ports": [
        80,
        443
      ],
      "layer": "workstream"
    }
  ],
  "passthrough": [],
  "inject": [
    {
      "name": "client:gh_read",
      "hosts": [
        "github.com",
        "api.github.com"
      ],
      "placeholder": "nest-ph.cli_01JTESTCLIENT.gh_read.",
      "locations": [
        {
          "type": "authorization_bearer"
        },
        {
          "type": "authorization_basic_password"
        }
      ]
    }
  ],
  "tcp": [],
  "limits": {
    "max_connections": 256,
    "bandwidth_mbps": 200,
    "max_inspected_body_bytes": 536870912
  },
  "guards": [
    {
      "name": "client:github-push",
      "hosts": [
        "github.com"
      ],
      "scope": [
        {
          "path": "/**/git-receive-pack"
        },
        {
          "path": "/**/info/refs",
          "query": [
            {
              "name": "service",
              "values": [
                "git-receive-pack"
              ]
            }
          ]
        }
      ],
      "reason": "this sandbox only reads by77er/nest",
      "ignore_case": true
    },
    {
      "name": "client:github-write",
      "hosts": [
        "github.com"
      ],
      "scope": [
        {
          "methods_except": [
            "GET",
            "HEAD"
          ]
        }
      ],
      "reason": "this sandbox only reads by77er/nest",
      "ignore_case": true,
      "allow": [
        {
          "methods": [
            "POST"
          ],
          "path": "/*/*/git-upload-pack"
        },
        {
          "methods": [
            "POST"
          ],
          "path": "/*/*/info/lfs/objects/batch",
          "body_json": {
            "pointer": "/operation",
            "values": [
              "download"
            ]
          }
        }
      ]
    },
    {
      "name": "client:github-api-write",
      "hosts": [
        "*.github.com"
      ],
      "scope": [
        {
          "methods_except": [
            "GET",
            "HEAD"
          ]
        }
      ],
      "reason": "this sandbox only reads by77er/nest; GraphQL goes only with this sandbox's own GitHub token",
      "ignore_case": true,
      "allow": [
        {
          "methods": [
            "POST"
          ],
          "path": "/graphql",
          "injected": "client:gh_read",
          "at": "authorization"
        }
      ]
    },
    {
      "name": "client:gist-write",
      "hosts": [
        "gist.github.com"
      ],
      "scope": [
        {
          "methods_except": [
            "GET",
            "HEAD"
          ]
        },
        {
          "path": "/**/info/refs",
          "query": [
            {
              "name": "service",
              "values": [
                "git-receive-pack"
              ]
            }
          ]
        }
      ],
      "reason": "gists are read-only from a sandbox",
      "ignore_case": true
    },
    {
      "name": "client:githubusercontent-write",
      "hosts": [
        "*.githubusercontent.com"
      ],
      "scope": [
        {
          "methods_except": [
            "GET",
            "HEAD"
          ]
        }
      ],
      "reason": "GitHub's content hosts are read-only from a sandbox",
      "ignore_case": true
    }
  ]
}
