{
  "version": 9,
  "allow": [
    {
      "host": "github.com",
      "ports": [
        443
      ],
      "layer": "base"
    },
    {
      "host": "*.githubusercontent.com",
      "ports": [
        443
      ],
      "layer": "base"
    },
    {
      "host": "api.github.com",
      "ports": [
        80,
        443
      ],
      "layer": "workstream"
    }
  ],
  "passthrough": [],
  "inject": [
    {
      "name": "github",
      "hosts": [
        "github.com",
        "api.github.com"
      ],
      "placeholder": "nest-ph-github",
      "locations": [
        {
          "type": "authorization_bearer"
        },
        {
          "type": "authorization_basic_password",
          "username": "x-access-token"
        }
      ]
    }
  ],
  "tcp": [],
  "limits": {
    "max_connections": 256,
    "bandwidth_mbps": 200,
    "max_inspected_body_bytes": 536870912
  },
  "guards": [
    {
      "name": "github-push",
      "hosts": [
        "github.com"
      ],
      "scope": [
        {
          "path": "/**/git-receive-pack"
        },
        {
          "path": "/**/info/refs",
          "query": [
            {
              "name": "service",
              "values": [
                "git-receive-pack"
              ]
            }
          ]
        }
      ],
      "reason": "git pushes reach only the repos on this sandbox's push allowlist (by77er/nest, by77er/nest-fork)",
      "ignore_case": true,
      "allow": [
        {
          "path": "/by77er/nest/**"
        },
        {
          "path": "/by77er/nest.git/**"
        },
        {
          "path": "/by77er/nest-fork/**"
        },
        {
          "path": "/by77er/nest-fork.git/**"
        }
      ]
    },
    {
      "name": "github-write",
      "hosts": [
        "github.com"
      ],
      "scope": [
        {
          "methods_except": [
            "GET",
            "HEAD"
          ]
        }
      ],
      "reason": "writes to GitHub reach only the repos on this sandbox's push allowlist (by77er/nest, by77er/nest-fork)",
      "ignore_case": true,
      "allow": [
        {
          "methods": [
            "POST"
          ],
          "path": "/*/*/git-upload-pack"
        },
        {
          "methods": [
            "POST"
          ],
          "path": "/*/*/info/lfs/objects/batch",
          "body_json": {
            "pointer": "/operation",
            "values": [
              "download"
            ]
          }
        },
        {
          "path": "/by77er/nest/**"
        },
        {
          "path": "/by77er/nest.git/**"
        },
        {
          "path": "/by77er/nest-fork/**"
        },
        {
          "path": "/by77er/nest-fork.git/**"
        }
      ]
    },
    {
      "name": "github-api-write",
      "hosts": [
        "*.github.com"
      ],
      "scope": [
        {
          "methods_except": [
            "GET",
            "HEAD"
          ]
        }
      ],
      "reason": "writes to GitHub reach only the repos on this sandbox's push allowlist (by77er/nest, by77er/nest-fork); GraphQL writes go only with the sandbox's own GitHub token",
      "ignore_case": true,
      "allow": [
        {
          "path": "/repos/by77er/nest/**"
        },
        {
          "path": "/repos/by77er/nest-fork/**"
        },
        {
          "methods": [
            "POST"
          ],
          "path": "/graphql",
          "injected": "github",
          "at": "authorization"
        }
      ]
    },
    {
      "name": "gist-write",
      "hosts": [
        "gist.github.com"
      ],
      "scope": [
        {
          "methods_except": [
            "GET",
            "HEAD"
          ]
        },
        {
          "path": "/**/info/refs",
          "query": [
            {
              "name": "service",
              "values": [
                "git-receive-pack"
              ]
            }
          ]
        }
      ],
      "reason": "gists are read-only from a sandbox",
      "ignore_case": true
    },
    {
      "name": "githubusercontent-write",
      "hosts": [
        "*.githubusercontent.com"
      ],
      "scope": [
        {
          "methods_except": [
            "GET",
            "HEAD"
          ]
        }
      ],
      "reason": "GitHub's content hosts are read-only from a sandbox",
      "ignore_case": true
    }
  ]
}
