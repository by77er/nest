[
  {
    "name": "notify",
    "description": "Send a short message to `captain` (your owner, or else whoever reads your escalation channel), to the user (via Discord), or to another agent's inbox. Does not wait for a reply.",
    "input_schema": {
      "type": "object",
      "properties": {
        "to": {
          "type": "string",
          "description": "Recipient: 'captain' (your owner, or your escalation channel's reader), 'user', or an agent id (agt_...)."
        },
        "message": {
          "type": "string",
          "description": "Message text."
        },
        "urgency": {
          "type": "string",
          "description": "normal or high (high may @-mention the user).",
          "enum": [
            "normal",
            "high"
          ]
        }
      },
      "required": [
        "to",
        "message"
      ],
      "additionalProperties": false
    },
    "requires_approval": false
  },
  {
    "name": "emit",
    "description": "Emit a structured workstream event (progress, blocked, pr_opened, completed, failed). Decision events wake the workstream channel's subscriber.",
    "input_schema": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "description": "Event type.",
          "enum": [
            "progress",
            "blocked",
            "pr_opened",
            "completed",
            "failed"
          ]
        },
        "summary": {
          "type": "string",
          "description": "Human-readable summary."
        },
        "url": {
          "type": "string",
          "description": "Related URL, e.g. the PR."
        },
        "title": {
          "type": "string",
          "description": "PR title (pr_opened)."
        }
      },
      "required": [
        "event",
        "summary"
      ],
      "additionalProperties": false
    },
    "requires_approval": false
  },
  {
    "name": "ask",
    "description": "Ask whoever reads your escalation channel (`captain`, the default) or the user a question. Answers within ~2 minutes are returned directly; otherwise the call returns 'pending', you should end your turn, and the answer arrives as your next input.",
    "input_schema": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "description": "The question."
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Suggested answers."
        },
        "to": {
          "type": "string",
          "description": "captain (your escalation channel; the default) or user.",
          "enum": [
            "captain",
            "user"
          ]
        }
      },
      "required": [
        "question"
      ],
      "additionalProperties": false
    },
    "requires_approval": false
  },
  {
    "name": "spawn_agent",
    "description": "Start a new worker agent in a workstream, optionally bound to a sandbox.",
    "input_schema": {
      "type": "object",
      "properties": {
        "workstream": {
          "type": "string",
          "description": "Workstream id (ws_...)."
        },
        "task": {
          "type": "string",
          "description": "Initial instructions."
        },
        "sandbox": {
          "type": "string",
          "description": "Sandbox to bind hands to (sbx_...); omit to create one."
        },
        "fork_session_of": {
          "type": "string",
          "description": "Fork the conversation of this agent (agt_...)."
        }
      },
      "required": [
        "workstream",
        "task"
      ],
      "additionalProperties": false
    },
    "requires_approval": false
  },
  {
    "name": "fork_sandbox",
    "description": "Fork a sandbox (copy-on-write). disk_only (default) is cheap; live also copies running processes.",
    "input_schema": {
      "type": "object",
      "properties": {
        "sandbox": {
          "type": "string",
          "description": "Sandbox to fork (sbx_...)."
        },
        "mode": {
          "type": "string",
          "description": "Fork mode.",
          "enum": [
            "disk_only",
            "live"
          ]
        },
        "read_only": {
          "type": "boolean",
          "description": "Child is for inspection; egress limited to base policy."
        }
      },
      "required": [
        "sandbox"
      ],
      "additionalProperties": false
    },
    "requires_approval": false
  },
  {
    "name": "attach",
    "description": "Bind (or with sandbox omitted, unbind) a worker agent's hands to a sandbox in the same workstream.",
    "input_schema": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "description": "Agent id (agt_...)."
        },
        "sandbox": {
          "type": "string",
          "description": "Sandbox id (sbx_...)."
        }
      },
      "required": [
        "agent"
      ],
      "additionalProperties": false
    },
    "requires_approval": false
  },
  {
    "name": "read_transcript",
    "description": "Read an agent's normalized transcript without waking anything.",
    "input_schema": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "description": "Agent id (agt_...)."
        },
        "since_seq": {
          "type": "integer",
          "description": "Return entries after this 1-based entry number (a line of the session JSONL)."
        },
        "base": {
          "type": "integer",
          "description": "The base a previous call returned with since_seq. If the transcript was rewritten since, the reply starts again from entry 1 and says reset."
        },
        "limit": {
          "type": "integer",
          "description": "Max entries (default 200)."
        }
      },
      "required": [
        "agent"
      ],
      "additionalProperties": false
    },
    "requires_approval": false
  },
  {
    "name": "checkpoint",
    "description": "Commit the bound sandbox's disk now (e.g. before a risky step).",
    "input_schema": {
      "type": "object",
      "properties": {
        "note": {
          "type": "string",
          "description": "Why."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "requires_approval": false
  },
  {
    "name": "expose_port",
    "description": "Expose a port of the bound sandbox as a preview URL (behind Access by default).",
    "input_schema": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "description": "Guest port.",
          "minimum": 1,
          "maximum": 65535
        },
        "share": {
          "type": "boolean",
          "description": "Also mint an expiring public share link (operator-only; refused for agents)."
        },
        "host_header": {
          "type": "string",
          "description": "Host header sent to the server.",
          "enum": [
            "localhost",
            "preserve"
          ]
        }
      },
      "required": [
        "port"
      ],
      "additionalProperties": false
    },
    "requires_approval": false
  },
  {
    "name": "brokered",
    "description": "Run a brokered action (e.g. github.create_pr, email.send, http.request) executed outside the sandbox with secrets the sandbox never sees. Available actions depend on your grants; tools/list may also expose them as dedicated tools.",
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Action name, e.g. github.create_pr."
        },
        "args": {
          "type": "object",
          "description": "Action arguments."
        }
      },
      "required": [
        "action",
        "args"
      ],
      "additionalProperties": false
    },
    "requires_approval": false
  },
  {
    "name": "spawn_workstream",
