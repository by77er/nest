#!/bin/sh
# git credential helper (gitcredentials(7)) for nest sandboxes: answers `get` for https://github.com with
# the placeholder nest-proxy swaps for the sandbox's own GitHub token (docs/sandbox/networking/egress/injection/#github).
# The placeholder is worthless outside nest-proxy, which also refuses it to any other host. Pushes reach
# only the repos on the sandbox's push allowlist, whatever credential they carry.
[ "$1" = get ] || exit 0
proto= host=
while IFS='=' read -r k v; do
  [ -z "$k" ] && break
  case $k in protocol) proto=$v ;; host) host=$v ;; esac
done
[ "$proto" = https ] && [ "$host" = github.com ] || exit 0
echo username=x-access-token
echo password=nest-ph-github
