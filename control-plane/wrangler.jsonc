{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nest-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "FLEET", "class_name": "FleetDO" },
      { "name": "SANDBOX", "class_name": "SandboxDO" },
      { "name": "AGENT", "class_name": "AgentDO" },
      { "name": "WORKSTREAM", "class_name": "WorkstreamDO" },
      { "name": "BROKER", "class_name": "BrokerDO" },
      { "name": "CATALOG", "class_name": "CatalogDO" },
      { "name": "CHANNEL", "class_name": "ChannelDO" },
      { "name": "TASKS", "class_name": "TaskLedgerDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FleetDO", "SandboxDO", "AgentDO", "WorkstreamDO", "BrokerDO"] },
    { "tag": "catalog", "new_sqlite_classes": ["CatalogDO"] },
    { "tag": "channels", "new_sqlite_classes": ["ChannelDO"] },
    { "tag": "tasks", "new_sqlite_classes": ["TaskLedgerDO"] }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "nest-control" }],
  // Production hostname (a Workers Custom Domain on the bitcru.sh zone; Cloudflare issues its certificate).
  // Deploys set PUBLIC_BASE_URL=https://nest.bitcru.sh, AWS_CELLS and the rest with --var; the vars below
  // are for `wrangler dev`.
  "routes": [{ "pattern": "nest.bitcru.sh", "custom_domain": true }],
  "vars": {
    "PUBLIC_BASE_URL": "http://127.0.0.1:8787",
    "ASK_SYNC_WINDOW_MS": "120000",
    "HOST_TOKEN_TTL_MS": "3600000",
    "PROXY_CA_TTL_MS": "604800000"
  }
  // Secrets (wrangler secret put / .dev.vars): ADMIN_TOKEN, HOST_TOKEN_SECRET,
  // ROOT_CA_CERT_PEM, ROOT_CA_KEY_PEM (PKCS#8, ECDSA P-256), AWS_IDENTITY_CERT_PEM,
  // AWS_CELL_CREDENTIALS (per cell; docs/compute/cells/), CLOUDFLARE_TUNNEL_API_TOKEN; legacy for one release:
  // AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION, ROOT_CA_KMS_KEY_ID.
  // Deploys also set NEST_DOMAIN and CLOUDFLARE_ACCOUNT_ID (vars); without them no host gets a tunnel,
  // which is what `wrangler dev` and the harness want.
}
