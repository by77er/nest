{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nest-dashboard",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request reaches the Worker first, so the page is served only after the Access check.
    "run_worker_first": true
  },
  "routes": [{ "pattern": "dash-nest.bitcru.sh", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    // Read-only: the control plane's admin API, and the cells it may be asked about.
    "NEST_CONTROL_PLANE": "https://nest.bitcru.sh",
    "NEST_CELLS": "use1",
    // The Worker admits only requests carrying a Cloudflare Access token (Cf-Access-Jwt-Assertion)
    // issued by this team for the dashboard's application: the edge stack (deploy/lean/Edge/) owns
    // the application, and `inframe output --stack edge` prints its `dashboard_aud`.
    "ACCESS_TEAM_DOMAIN": "https://bitcrush.cloudflareaccess.com",
    "DASHBOARD_AUD": "cfb5ed2f974fe3d920b95a25b6a1c6fa236697e605c65a0c641585ca1563b3b5"
  }
  // Secret (wrangler secret put / .dev.vars): NEST_ADMIN_TOKEN, the control plane's admin token.
  // The page never sees it: the Worker adds it to the GETs it makes (the fleet and images views, and
  // each listed agent's record) and nothing else.
}
